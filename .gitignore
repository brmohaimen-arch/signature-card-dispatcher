target/

# Runtime data: customer cards, requests, logs, quarantine
work/

# Secrets and server-specific files: never commit
config/secrets.enc
config/backups/
config/known_hosts
config/source_known_hosts
config/.validate-*
*.enc
*.pem
*.key
id_*

# JVM crash reports
hs_err_pid*.log
replay_pid*.log

# Local test data (may contain real responses) and local test folders
config/test-customers.json
config/test-branches.json
local-test/
